APP_NAME="Campus Reserve"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Generate environment-specific keys with:
# php artisan key:generate --env=local
# php artisan key:generate --env=staging
# php artisan key:generate --env=production
APP_KEY=

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campus_reserve
DB_USERNAME=root
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie

# Security
CIPHER=AES-256-CBC
