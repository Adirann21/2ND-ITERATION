APP_NAME="Campus Reserve"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://campusreserve.com

# PRODUCTION ENVIRONMENT KEY
# Generate with: php artisan key:generate --env=production
# REPLACE THIS WITH YOUR ACTUAL PRODUCTION KEY
# STORE THIS KEY IN A SECURE VAULT (e.g., AWS Secrets Manager, HashiCorp Vault)
APP_KEY=base64:P0qR1sT2uV3wX4yZ5aB6cD7eF8gH9iJ0kL1mN2oP3=

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=prod-db.example.com
DB_PORT=3306
DB_DATABASE=campus_reserve_prod
DB_USERNAME=prod_user
DB_PASSWORD=your_secure_password

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@campusreserve.com"
MAIL_FROM_NAME="${APP_NAME}"

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie

# Security
CIPHER=AES-256-CBC
