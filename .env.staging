APP_NAME="Campus Reserve"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.campusreserve.com

# STAGING ENVIRONMENT KEY
# Generate with: php artisan key:generate --env=staging
# REPLACE THIS WITH YOUR ACTUAL STAGING KEY
APP_KEY=base64:A1bC2dE3fG4hI5jK6lM7nO8pQ9rS0tU1vW2xY3zA4=

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=staging-db.example.com
DB_PORT=3306
DB_DATABASE=campus_reserve_staging
DB_USERNAME=staging_user
DB_PASSWORD=your_staging_password

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_user
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@campusreserve.com"
MAIL_FROM_NAME="${APP_NAME}"

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie

# Security
CIPHER=AES-256-CBC
